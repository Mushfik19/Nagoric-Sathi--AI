# Environment & Project Settings
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nagoriksathi_db
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/nagoriksathi_db

# Redis Message Queue & Caching
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3 Compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=nagoriksathi-media
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadminpassword

# Security & Secrets
JWT_SECRET=super-secret-nagorik-sathi-jwt-key-2026-production
SESSION_SECRET=super-secret-nagorik-sathi-session-key-2026

# AI Pipeline & Providers
AI_PROVIDER=bangla_nlp_baseline_onnx
AI_MODEL=banglabert-civic-v1
EMBEDDING_MODEL=bangla-sentence-embeddings
ROUTING_CONFIDENCE_GATE_DEFAULT=0.80

# Notifications Adapters (SMS / Email)
OTP_PROVIDER=mock_otp_service
SMS_PROVIDER=mock_sms_gateway
EMAIL_PROVIDER=smtp_mock
